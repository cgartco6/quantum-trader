{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quantum Trader Desktop",
  "version": "1.0.0",
  "identifier": "com.quantumtrader.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace=apps/web",
    "beforeBuildCommand": "npm run build --workspace=apps/web",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../../apps/web/out"
  },
  "app": {
    "windows": [
      {
        "title": "Quantum Trader // Terminal",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws://localhost:8000 http://localhost:8000 https://api.quantumtrader.io wss://api.quantumtrader.io;"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
